# Agent 1.0 parameters, read when the agent starts (restart it after a change).
# One per line: NAME=value. Text after " #" is a comment.
#   auto    the agent decides (the thread counts then follow the machine's cores)
#   empty   for a folder or file: turns that part off
# Paths are relative to this folder. A deleted line falls back to the value shown here.
# A variable set in the shell wins over this file for that run, e.g. in PowerShell:
#   $env:PORT=9000; node agent.mjs
# The game settings (quantumness, board size, time limit) are not here: the arena sends them with every move.

# ---- Server ----
PORT=8081                       # local port: the arena connector calls http://127.0.0.1:PORT/move
AI_NAME=christos-athanasios     # name shown by /health

# ---- Threads ----
# TiqTaqToe search threads in total, and how many of them search one move.
# auto: cores - 2 in total (at least 2, at most 6), and 2 fewer per move (at least 1).
BOT_WORKERS=auto
BOT_THREADS_PER_MOVE=auto
CHEQQERS_THREADS=3              # Cheqqers search threads; one game at a time needs only 1
# For a small machine:
#   BOT_WORKERS=2, BOT_THREADS_PER_MOVE=1, CHEQQERS_THREADS=1

# ---- Time per move ----
# The limit arrives with every move. The organizers measure it on their side, so the network time
# counts too.
TIME_MARGIN_MS=500              # every answer, in both games, is sent this long before the limit, so the same
                                #   time is always left for the network. The search ends just before (TiqTaqToe
                                #   0.3 s, Cheqqers 0.2 s); a limit no longer than this gets an answer at once.
BOT_MAX_SEARCH_MS=4000          # TiqTaqToe never searches longer than this

# ---- Game settings that a request leaves out ----
# Every move's request carries its settings, and the agent always uses them. These defaults apply
# only to a setting that a request does not include. They are the tournament's settings, as the
# organizers' arena rules and guides give them: TiqTaqToe 5 s, quantumness 2, no decoherence;
# Cheqqers 3 s, 6x6 board, quantumness 2.
BOT_DEFAULT_MOVE_TIME=5           # TiqTaqToe time limit, in seconds
BOT_DEFAULT_QUANTUMNESS=2         # TiqTaqToe quantumness, 0-4
BOT_DEFAULT_DECOHERENCE=0         # TiqTaqToe decoherence, 0-3 (0 = off)
CHEQQERS_DEFAULT_TIMEOUT_MS=3000  # Cheqqers time limit, in milliseconds
CHEQQERS_DEFAULT_QUANTUMNESS=2    # Cheqqers quantumness, 0-3
CHEQQERS_DEFAULT_BOARD_SIZE=6     # 4, 6, 8 or 10; used only if the board's length does not show the size

# ---- Game records: one JSON line per move (empty = don't record) ----
BOT_RECORD_DIR=games/tiqtaqtoe
CHEQQERS_RECORD_DIR=games/cheqqers

# ---- TiqTaqToe strategy (DESIGN.md §2) ----
BOT_BOOK=tiqtaqtoe/data/opening-book.json  # opening book, used at quantumness 2 / decoherence 0 (empty = off)
BOT_PRIOR=off                   # learned move prior (tiqtaqtoe/data): on or off. Off, the search plays alone.
BOT_PRIOR_WEIGHT=1              # when on: bonus for a move, weight x P(move) / (1 + visits)
BOT_PRIOR_WIDENING=1            # when on: a node opens at most widening x sqrt(visits) of its moves (0 = no limit)
BOT_PRIOR_LEVELS=2              # when on: quantumness levels where the prior guides the search (2, or 2,3, or all);
                                #   it learned from level-2 games only. The level is the request's.
BOT_TREE_STEPS=2000             # size of each small tree; the search runs many and merges them
BOT_EXPLORATION=1               # exploration constant of the tree search (UCB)
BOT_DRAW_VALUE=0.5              # what a draw is worth to the search (a win is 1)
BOT_BOTH_VALUE=0.5              # what a "both won" is worth (the tournament scores it as a draw)

# ---- Cheqqers strategy (DESIGN.md §3) ----
CHEQQERS_MAX_DEPTH=8            # moves played ahead before the position is scored
CHEQQERS_EXPLORATION=0.9        # exploration constant of the tree search (UCB)
